# Copy to .env and fill in. Never commit .env: it holds the shared secret.
# Generate a token:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Required. The server refuses to start when this is empty, so the service cannot come up open.
ERGON_TOKEN=

# The capability boundary. argv[0] of every job must appear here. Keep the list as short as the jobs
# allow: a shell entry (sh, bash) defeats the no-shell posture the design rests on.
ERGON_ALLOW=python3

# Host directory jobs run inside, mounted at /workspace. Use a dedicated path, not a home directory.
# A relative path resolves against this file's directory, which is why ./workspace is the default.
ERGON_WORKSPACE=./workspace

# Port published on the host. Set it to 127.0.0.1:8000 form in docker-compose.yml when the host is
# not inside a trusted network.
ERGON_HOST_PORT=8000

# Environment variables passed through to jobs. Everything else is withheld, and the server keeps a
# deny-list for loader and interpreter variables (LD_PRELOAD, PYTHONSTARTUP, BASH_ENV and friends)
# that no job should inherit even when named here.
ERGON_PASS_ENV=PATH,HOME,LANG

# Resource limits. One capped job costs about ERGON_LOG_CAP_MB on the state volume, and the bound is
# per job, so total use scales with jobs. The code defaults are 64 MB and 16 jobs; these values are
# tighter on purpose.
ERGON_LOG_CAP_MB=16
ERGON_MAX_JOBS=8

# The ceiling a per-job log_cap_mb request may not exceed. start_job refuses above it.
ERGON_LOG_CAP_MAX_MB=64

# Seconds between reaps of finished processes.
ERGON_REAP_SECONDS=2

# Retention, in hours, of finished job records and their logs. Anything that must outlast the window
# belongs in a store, not in the state volume. The server refuses to start below 1 hour.
ERGON_RETAIN_HOURS=72

# The youngest window a prune_jobs request may ask for, so a token alone cannot prune younger than
# the retention rule.
ERGON_PRUNE_MIN_HOURS=72

# Refuse start_job when free space on the state volume falls below this many MB, and report the
# number measured. 0 disables the floor.
ERGON_MIN_FREE_MB=512

# Image tag to build and run. It lives here, not in docker-compose.yml, so a release does not
# invalidate the compose file.
ERGON_TAG=0.1.0
